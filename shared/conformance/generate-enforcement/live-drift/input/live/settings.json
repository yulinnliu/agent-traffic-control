{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "PowerShell(git push --force *)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Edit(~/.claude/hooks/**)",
      "Read(logs/**)"
    ]
  }
}
