#!/bin/sh
# GENERATED by agent-traffic-control from hard-deny.yaml. Do not hand-edit;
# regenerate on a policy change.
#
# Refuses a commit that adds or modifies a hard-denied path. Active when
# core.hooksPath points at this directory.
#
# Not git-enforced here (the runtime adapter's job):
#   ~/.claude/hooks/**  [edit, write]
#   logs/**  [read]

hit=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)(\.env)$|^authorizations/' || true)
if [ -n "$hit" ]; then
    echo "pre-commit: refusing hard-denied path(s) (hard-deny.yaml):"
    echo "$hit"
    exit 1
fi
